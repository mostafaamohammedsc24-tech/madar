# Twilio Verify (SMS OTP) — set these as Supabase Edge Function secrets, NOT in Flutter.
# supabase secrets set TWILIO_API_KEY=SKxxxx TWILIO_API_SECRET=xxxx TWILIO_VERIFY_SERVICE_SID=VAxxxx
#
# Create / ensure Verify service (same as Twilio docs):
# curl -X POST "https://verify.twilio.com/v2/Services" \
#   --data-urlencode "FriendlyName=Madar Verify" \
#   -u $TWILIO_API_KEY:$TWILIO_API_SECRET
#
# Then store the returned sid as TWILIO_VERIFY_SERVICE_SID.

TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_FRIENDLY_NAME=Madar Verify

# Optional fallback auth (instead of API key):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
